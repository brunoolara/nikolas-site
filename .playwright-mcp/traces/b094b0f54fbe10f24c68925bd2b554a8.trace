,"jsshadow":"","aria-describedby":"h.xgkp9nqqxq4f_l","aria-label":"Copiar link do título","aria-disabled":"false","data-tooltip":"Copiar link do título","aria-hidden":"true","data-tooltip-position":"top","data-tooltip-vertical-offset":"12","data-tooltip-horizontal-offset":"0"},["A",{"class":"FKF6mc TpQm9d","href":"#h.xgkp9nqqxq4f","aria-label":"Copiar link do título","jsname":"hiK3ld","role":"button","aria-describedby":"h.xgkp9nqqxq4f_l"},["DIV",{"class":"VTBa7b MbhUzd","jsname":"ksKsZd"}],["SPAN",{"jsslot":"","class":"xjKiLb"},["SPAN",{"class":"Ce1Y1c","style":"top: -11px"},["svg",{"class":"OUGEr QdAdhf","width":"22px","height":"22px","viewBox":"0 0 24 24","fill":"currentColor","focusable":"false"},["path",{"d":"M0 0h24v24H0z","fill":"none"}],["path",{"d":"M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"}]]]]]]],["SPAN",{"class":"Rn3Z1b C9DxTc ","style":"vertical-align: baseline;"},"Nossos destaques e tradição"]]]]]]],["DIV",{"class":"oKdM2c ZZyype"},["DIV",{"id":"h.3bc057281f41c98b_45","class":"hJDwNd-AhqUyc-OwsYgb Ft7HRd-AhqUyc-OwsYgb jXK9ad D2fZ2 zu5uec wHaque g5GTcb"},["DIV",{"class":"jXK9ad-SmKAyb"},["DIV",{"class":"tyJCtd mGzaTb Depvyb baZpAe"},["P",{"dir":"ltr","class":"zfr3Q CDt4Ke ","style":"background-color: transparent; border-bottom: none; border-left: none; border-right: none; border-top: none; line-height: 1.38; margin-bottom: 12.0pt; margin-top: 12.0pt; padding-bottom: 0.0pt; padding-left: 0.0pt; padding-right: 0.0pt; padding-top: 0.0pt;"},["SPAN",{"class":"C9DxTc ","style":"font-family: Montserrat, Arial; font-size: 13.999999999999998pt; font-weight: 700; vertical-align: baseline;"},"Entre os destaques mais tradicionais da casa estão o feijão tropeiro, a salada de berinjela, a dobradinha, o chope e o nosso viradão à mineira — pratos que fazem parte da nossa história desde 1977. E história é o que não falta por aqui!"]],["P",{"dir":"ltr","class":"zfr3Q CDt4Ke ","style":"background-color: transparent; border-bottom: none; border-left: none; border-right: none; border-top: none; line-height: 1.38; margin-bottom: 12.0pt; margin-top: 12.0pt; padding-bottom: 0.0pt; padding-left: 0.0pt; padding-right: 0.0pt; padding-top: 0.0pt;"},["SPAN",{"class":"C9DxTc ","style":"font-family: Montserrat, Arial; font-size: 13.999999999999998pt; font-weight: 700; vertical-align: baseline;"},"O feijão tropeiro, especialidade da casa, é servido todos os dias e é a escolha certa para quem busca qualidade, sabor e tradição."]],["P",{"dir":"ltr","class":"zfr3Q CDt4Ke ","style":"background-color: transparent; border-bottom: none; border-left: none; border-right: none; border-top: none; line-height: 1.38; margin-bottom: 12.0pt; margin-top: 12.0pt; padding-bottom: 0.0pt; padding-left: 0.0pt; padding-right: 0.0pt; padding-top: 0.0pt;"},["SPAN",{"class":"C9DxTc ","style":"font-family: Montserrat, Arial; font-size: 13.999999999999998pt; font-weight: 700; vertical-align: baseline;"},"Já o chope, sempre gelado, cremoso e refrescante, é o acompanhamento perfeito para qualquer prato ou petisco."]],["P",{"dir":"ltr","class":"zfr3Q CDt4Ke ","style":"background-color: transparent; border-bottom: none; border-left: none; border-right: none; border-top: none; line-height: 1.38; margin-bottom: 12.0pt; margin-top: 12.0pt; padding-bottom: 0.0pt; padding-left: 0.0pt; padding-right: 0.0pt; padding-top: 0.0pt;"},["SPAN",{"class":"C9DxTc ","style":"font-family: Montserrat, Arial; font-size: 13.999999999999998pt; font-weight: 700; vertical-align: baseline;"},"E as saladas… essas são inigualáveis (não somos só nós que dizemos!). Sempre frescas, cheias de sabor e capazes de acompanhar qualquer escolha do cardápio."]],["BR"]]]]]]]]]]],["SECTION",{"id":"h.3bc057281f41c98b_33","class":"yaqOZd WxWicb"},["DIV",{"class":"IFuOkc"}],["DIV",{"class":"mYVXT"},["DIV",{"class":"LS81yb VICjCf j5pSsc db35Fc","tabind