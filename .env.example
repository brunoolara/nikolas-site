# Variáveis que o projeto usa. Copie para .env.local e preencha.
# As do Blob vêm prontas com: vercel link && vercel env pull

# Senha única do painel de edição do cardápio (/admin).
# Em produção, criar com:  vercel env add SENHA_PAINEL
SENHA_PAINEL=

# Preenchidas automaticamente pela Vercel ao conectar a loja Blob:
# BLOB_READ_WRITE_TOKEN=

# Chave da API da Takeat (AI Builders, escopo table-sessions:read), usada pela
# Caixinha para ler a taxa de serviço do dia. Só no servidor; nunca no Git.
# Em produção, criar com:  vercel env add TAKEAT_API_KEY
TAKEAT_API_KEY=
